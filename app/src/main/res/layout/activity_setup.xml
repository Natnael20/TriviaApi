<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".SetupActivity">

    <!-- MAIN CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- NETWORK BANNER -->
        <include
            android:id="@+id/networkBannerInclude"
            layout="@layout/banner_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TOP BAR (Cortex + hamburger) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/networkBannerInclude"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/brandTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <ImageView
                android:id="@+id/menuButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_menu_hamburger"
                android:contentDescription="Menu"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- SCROLLABLE SETUP CONTENT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toTopOf="@id/startQuizButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/setupTitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready For Today's Challenge?"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"/>

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/setupSubtitleTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose your challenge"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
                
                <!-- AMOUNT -->
                <TextView
                    android:id="@+id/amountLabelTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NUMBER OF QUESTIONS"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"/>

                <TextView
                    android:id="@+id/amountValueTextView"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="10 questions"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/dropdown_background"
                    android:layout_marginTop="8dp"/>

                <!-- CATEGORY -->
                <TextView
                    android:id="@+id/categoryLabelTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CATEGORY"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:layout_marginTop="32dp"/>

                <TextView
                    android:id="@+id/categoryValueTextView"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Any Category"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/dropdown_background"
                    android:layout_marginTop="8dp"/>

                <!-- DIFFICULTY -->
                <TextView
                    android:id="@+id/difficultyLabelTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIFFICULTY"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"/>

                <LinearLayout
                    android:id="@+id/difficultyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/easyChip"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Easy"
                        android:textColor="@color/success"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/chip_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/mediumChip"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Medium"
                        android:textColor="@color/warning"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/chip_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:id="@+id/hardChip"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Hard"
                        android:textColor="@color/error"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:background="@drawable/chip_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

                <!-- TYPE -->
                <TextView
                    android:id="@+id/typeLabelTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TYPE OF QUESTIONS"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:layout_marginTop="24dp"/>

                <TextView
                    android:id="@+id/typeValueTextView"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Any Type"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/dropdown_background"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </ScrollView>

        <!-- START BUTTON (fixed at bottom) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/startQuizButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="START QUIZ"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/text_primary"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/primary"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SLIDE-IN DRAWER -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/surface_dark"
        android:padding="16dp"
        android:elevation="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MENU"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:id="@+id/drawerItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>