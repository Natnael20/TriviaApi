<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="24dp"
    tools:context=".MainActivity">

    <include
        android:id="@+id/networkBannerInclude"
        layout="@layout/banner_network"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- WELCOME BLOCK -->
    <LinearLayout
        android:id="@+id/centerBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@+id/networkBannerInclude"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/welcomeLabelTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WELCOME TO"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.3"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="56sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:layout_marginTop="4dp"/>

        <View
            android:id="@+id/accentLine"
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:background="@color/accent"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/taglineTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/missionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your all-in-one brain training platform. Sharpen your knowledge, build winning streaks, and track your progress across every subject."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:layout_marginTop="20dp"/>

    </LinearLayout>
    
    <!-- HIGH SCORE BOX -->
    <LinearLayout
        android:id="@+id/highScoreRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/high_score_box_bg"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@+id/centerBlock"
        app:layout_constraintBottom_toTopOf="@+id/playSoloButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEST  "
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.2"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/highScoreValueTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="   ·   "
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAK  "
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.2"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/bestStreakValueTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/warning"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/playSoloButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="GET STARTED"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="@color/text_primary"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/primary"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/versionTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- VERSION FOOTER -->
    <TextView
        android:id="@+id/versionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>